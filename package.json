{
  "name": "htf-2026-codebase",
  "version": "0.1.0",
  "private": true,
  "description": "Oakhaven — HTF 2026 hackathon base app (SAP CAP + SAPUI5, TypeScript)",
  "scripts": {
    "watch": "cds watch",
    "build": "cds build",
    "db:reset": "cds deploy --to sqlite:db/oakhaven.sqlite",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --require ts-node/register --test \"srv/domain/*.test.ts\"",
    "lint:ui5": "ts-node scripts/lint-ui5.ts"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10.1.2",
    "@sapui5/types": "^1.152.0",
    "@types/node": "^22.18.0",
    "@ui5/cli": "^4.0.69",
    "@ui5/linter": "^1.23.6",
    "cds-plugin-ui5": "^0.17.4",
    "oakhaven-launchpad": "file:launchpad",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ui5-tooling-transpile": "^3.13.1"
  },
  "dependencies": {
    "@sap/cds": "^10.1.1",
    "@tabler/icons-webfont": "^3.48.0"
  }
}
