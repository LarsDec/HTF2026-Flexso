<mvc:View
    controllerName="oakhaven.council.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    core:require="{ formatter: 'oakhaven/council/model/formatter', DateTimeOffset: 'sap/ui/model/odata/type/DateTimeOffset' }"
    displayBlock="true"
    height="100%">
    <f:DynamicPage id="page">
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="pageTitleText" text="{i18n>pageTitle}" level="H1" wrapping="true" />
                </f:heading>
                <f:expandedContent>
                    <VBox id="pageSubtitleBox">
                        <Label id="pageSubtitle" text="{i18n>pageSubtitle}" wrapping="true" />
                        <Label id="pageMadeOn" wrapping="true"
                            text="{ parts: ['i18n>madeOn', { path: '/Summary(\'current\')/generatedAt', type: 'DateTimeOffset', constraints: { precision: 7 }, formatOptions: { style: 'medium' } }], formatter: 'formatter.madeOn' }" />
                    </VBox>
                </f:expandedContent>
                <f:actions>
                    <Button id="refreshButton" class="councilNoPrint" icon="sap-icon://refresh" text="{i18n>refresh}" tooltip="{i18n>refreshTooltip}" press=".onRefresh" />
                    <Button id="printButton" class="councilNoPrint" type="Emphasized" icon="sap-icon://print" text="{i18n>print}" tooltip="{i18n>printTooltip}" press=".onPrint" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <core:Fragment id="councilPage" fragmentName="oakhaven.council.fragment.CouncilPage" type="XML" />
        </f:content>
    </f:DynamicPage>
</mvc:View>
